<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WpfTesting.Mcp</RootNamespace>
    <AssemblyName>WpfTesting.Mcp</AssemblyName>
    <!-- FlaUI 5.0.0 ships .NET Framework assets only; it runs fine on modern .NET on Windows.
         PackAsTool rejects a -windows TFM, so CA1416 (Windows-only APIs) is silenced; the server is Windows-only. -->
    <NoWarn>$(NoWarn);NU1701;CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>meteion-wpf-mcp</ToolCommandName>
    <PackageId>Meteion.WpfTesting.Mcp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Meteion</Authors>
    <Company>Meteion</Company>
    <Description>An MCP server that lets AI agents drive a WPF application through UI Automation (FlaUI UIA3) to run UI tests.</Description>
    <PackageTags>mcp;wpf;flaui;ui-automation;testing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Meteion-Software/wpf-testing-supercharged</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Meteion-Software/wpf-testing-supercharged</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
